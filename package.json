{
  "name": "taxi-partner-app",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "backend": "node scripts/mvp-backend.mjs",
    "backend:pilot": "node scripts/start-pilot-backend.mjs",
    "dev:local": "node scripts/start-local-dev.mjs",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "node --stack_size=8192 node_modules/typescript/lib/tsc.js --noEmit",
    "build:web": "EXPO_BASE_URL=/taxi expo export --platform web --output-dir dist && node scripts/inject-web-splash.mjs dist/index.html",
    "postexport:splash": "node scripts/inject-web-splash.mjs dist/index.html",
    "test:dispatch": "node scripts/dispatch-smoke-test.mjs",
    "test:driver-billing": "node scripts/driver-billing-smoke-test.mjs",
    "test:driver-billing:yookassa": "node scripts/driver-billing-yookassa-smoke-test.mjs",
    "test:driver-billing:tbank": "node scripts/driver-billing-tbank-smoke-test.mjs",
    "test:documents": "node scripts/driver-documents-smoke-test.mjs",
    "test:auth-delivery": "node scripts/auth-delivery-smoke-test.mjs",
    "test:geo-messaging": "node scripts/geo-messaging-smoke-test.mjs",
    "test:realtime": "node scripts/realtime-smoke-test.mjs",
    "test:registration-no-sms": "node scripts/registration-no-sms-smoke-test.mjs",
    "test:referrals": "node scripts/referral-smoke-test.mjs",
    "test:verification": "node scripts/verification-smoke-test.mjs",
    "pilot:readiness": "node scripts/closed-pilot-readiness.mjs",
    "prepare:pilot-apk": "node scripts/prepare-pilot-apk.mjs",
    "build:pilot-apk": "npm run prepare:pilot-apk && npx eas-cli build --platform android --profile pilot-apk",
    "release:check-env": "node scripts/validate-release-env.mjs",
    "sms:gateway": "node scripts/android-sms-gateway.mjs",
    "import:salavat-streets": "node scripts/import-salavat-streets.mjs",
    "import:salavat-addresses": "node scripts/import-salavat-addresses.mjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@react-navigation/native": "^7.1.0",
    "@react-navigation/native-stack": "^7.3.0",
    "apn": "^2.2.0",
    "expo": "~54.0.33",
    "expo-device": "~8.0.10",
    "expo-haptics": "~15.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-location": "~19.0.8",
    "expo-notifications": "^0.32.17",
    "expo-status-bar": "~3.0.9",
    "firebase-admin": "^13.10.0",
    "lucide-react-native": "^1.14.0",
    "pg": "^8.21.0",
    "react": "19.1.0",
    "react-dom": "^19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-sse": "^1.2.1",
    "react-native-svg": "^15.15.5",
    "react-native-web": "^0.21.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
